rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function perfilAtual() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }
    function autenticado() { return request.auth != null; }
    function ativo() { return autenticado() && perfilAtual().status == 'ATIVO'; }
    function ehDPP() { return ativo() && perfilAtual().perfil == 'DPP'; }
    function ehSR() { return ativo() && perfilAtual().perfil == 'SR'; }
    function ehDirOuCpen() { return ativo() && (perfilAtual().perfil == 'DIR' || perfilAtual().perfil == 'CPEN'); }
    // USUARIO/PSICOLOGIA/SOCIAL: nivel de unidade, mesmo alcance entre si —
    // so muda o rotulo da funcao (psicologo(a)/assistente social/outro
    // servidor), ja e como o proprio index.html trata os tres em
    // PERFIS_NIVEL_USUARIO. Antes desta correcao so 'USUARIO' entrava aqui,
    // o que travava o autocadastro de Psicologia/Assistente Social (a conta
    // de login chegava a ser criada mas o cadastro no Firestore era
    // recusado, sem opcao de tentar de novo com o mesmo e-mail).
    function ehNivelUnidade() { return ativo() && perfilAtual().perfil in ['USUARIO','PSICOLOGIA','SOCIAL']; }
    function minhaUnidade(unidade) { return ehDirOuCpen() && perfilAtual().unidade == unidade; }
    function minhaSR(sr) { return ehSR() && perfilAtual().sr == sr; }
    // SR_PSICOLOGIA/SR_SOCIAL: psicologo(a)/assistente social de cobertura
    // movel da regional (sem unidade fixa, circula entre as unidades da SR).
    // Ao contrario do "SR" (so-leitura/administrativo), estes CRIAM exame —
    // por isso tem uma checagem propria em vez de entrar em minhaSR().
    function ehSRCobertura() { return ativo() && perfilAtual().perfil in ['SR_PSICOLOGIA','SR_SOCIAL']; }
    function minhaSRComoCobertura(sr) { return ehSRCobertura() && perfilAtual().sr == sr; }
    // Contas. Perfis: USUARIO, CPEN, DIR (vinculados a uma unidade), SR
    // (vinculado a uma regional), SR_PSICOLOGIA/SR_SOCIAL (vinculados a uma
    // regional, cobertura movel entre unidades), DPP (acesso total). O
    // autocadastro grava perfilSolicitado (o que a pessoa pediu) e so vira
    // "perfil" de verdade quando alguem com alcada aprova (ve regras de
    // update abaixo).
    match /usuarios/{uid} {
      allow create: if autenticado()
        && request.auth.uid == uid
        && request.resource.data.status == 'PENDENTE'
        && request.resource.data.perfil == null
        && request.resource.data.perfilSolicitado in ['USUARIO','PSICOLOGIA','SOCIAL','CPEN','DIR','SR','SR_PSICOLOGIA','SR_SOCIAL','HCTP','DPP'];
      allow read: if autenticado() && (
        request.auth.uid == uid
        || ehDPP()
        || minhaSR(resource.data.sr)
        || minhaUnidade(resource.data.unidade)
      );
      // DPP aprova/edita/exclui/cria qualquer conta, qualquer perfil (o
      // "cria" cobre tanto o bootstrap de contas em lote quanto o caso de
      // "SR e SR_PSICOLOGIA/SR_SOCIAL so sao adicionados pelo DPP").
      allow create, update, delete: if ehDPP();
      // SR aprova pendente de CPEN/DIR/USUARIO/PSICOLOGIA/SOCIAL da propria
      // regional, e tambem suspende/exclui qualquer conta "abaixo" da sua SR.
      // SR_PSICOLOGIA/SR_SOCIAL so sao aprovados/excluidos pelo DPP acima —
      // de proposito nao entram nesta lista, ficam fora da alcada do SR.
      allow update: if ehSR()
        && resource.data.status == 'PENDENTE'
        && resource.data.sr == perfilAtual().sr
        && resource.data.perfilSolicitado in ['USUARIO','PSICOLOGIA','SOCIAL','CPEN','DIR']
        && request.resource.data.perfil == resource.data.perfilSolicitado
        && request.resource.data.status == 'ATIVO';
      allow delete: if ehSR()
        && resource.data.perfil in ['USUARIO','PSICOLOGIA','SOCIAL','CPEN','DIR']
        && resource.data.sr == perfilAtual().sr;
      // DIR/CPEN aprova pendente de USUARIO/PSICOLOGIA/SOCIAL da propria
      // unidade, e suspende/exclui qualquer um dos tres ja ativo na unidade.
      allow update: if ehDirOuCpen()
        && resource.data.status == 'PENDENTE'
        && resource.data.unidade == perfilAtual().unidade
        && resource.data.perfilSolicitado in ['USUARIO','PSICOLOGIA','SOCIAL']
        && request.resource.data.perfil == resource.data.perfilSolicitado
        && request.resource.data.status == 'ATIVO'
        && request.resource.data.unidade == perfilAtual().unidade;
      allow delete: if ehDirOuCpen()
        && resource.data.perfil in ['USUARIO','PSICOLOGIA','SOCIAL']
        && resource.data.unidade == perfilAtual().unidade;
      // A propria conta ATIVA so mexe na matricula (liga a conta a equipe
      // examinadora dos exames), em "conta institucional sem matricula" e no
      // marco dos avisos de exames novos — nunca em perfil, status, unidade ou SR.
      allow update: if autenticado()
        && request.auth.uid == uid
        && resource.data.status == 'ATIVO'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['matricula','semMatricula','avisosVistoEm'])
        && (!('matricula' in request.resource.data) || (request.resource.data.matricula is string && request.resource.data.matricula.size() <= 40));
    }
    // Contatos: nome, e-mail e matricula de cada conta ATIVA, para montar o
    // aviso por e-mail a equipe examinadora (usuarios/{uid} nao e legivel por
    // qualquer um). Cada pessoa so publica o proprio, copiado do seu cadastro
    // e com o e-mail do proprio login.
    match /contatos/{uid} {
      allow read: if ativo();
      allow create, update: if ativo()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.matricula == perfilAtual().matricula
        && request.resource.data.nome == perfilAtual().nome
        && request.resource.data.perfil == perfilAtual().perfil
        // unidade e regional tambem copiadas do cadastro (o aviso por e-mail as usa para escolher os destinatarios)
        && request.resource.data.get('unidade', null) == perfilAtual().get('unidade', null)
        && request.resource.data.get('sr', null) == perfilAtual().get('sr', null);
      allow delete: if (autenticado() && request.auth.uid == uid) || ehDPP();
    }
    // Exames: USUARIO/DIR/CPEN so veem/editam da propria unidade; SR le E
    // cria/edita as da propria regional (dashboard + cadastro direto, ex.:
    // quando precisa lancar/corrigir um exame sem depender de outro perfil);
    // SR_PSICOLOGIA/SR_SOCIAL leem E criam/editam as da propria regional
    // (cobertura movel entre unidades); DPP tem acesso total.
    // Centros de Observacao: configuracao compartilhada (equipe padrao,
    // unidades vinculadas, nome). Antes ficava so no localStorage de cada
    // navegador e se perdia em outro computador/login. Qualquer conta ATIVA
    // le (a equipe padrao pre-preenche o novo exame); so o DPP grava qualquer
    // Centro e o SR grava apenas o da propria regional (SR01 -> coc1 ... SR08 -> coc8).
    // Quadro de profissionais (psicologos(as), assistentes sociais e
    // medicos(as) lotados nas unidades, por regional) usado para preencher a
    // equipe examinadora. Tem nome e matricula de servidores, por isso fica no
    // banco (so contas ATIVAS leem) e nao no index.html, que e publico. So o
    // DPP importa/atualiza.
    match /profissionais/{docId} {
      allow read: if ativo();
      allow create, update, delete: if ehDPP();
    }
    match /centros/{cocId} {
      allow read: if ativo();
      allow create, update: if ehDPP()
        || (ehSR() && perfilAtual().sr.replace('SR0', 'coc') == cocId);
      allow delete: if ehDPP();
    }
    // Trilha de auditoria dos exames. Toda gravacao em exames/{id}:
    //  - leva rev = rev anterior + 1 (controle de concorrencia: quem salva em
    //    cima de uma versao velha e recusado em vez de apagar o trabalho do colega);
    //  - leva updatedBy = quem esta logado e updatedAt = hora do servidor;
    //  - so e aceita se, no MESMO lote, for criado exames/{id}/historico/{rev}
    //    (quem, quando, acao, secoes e valores antes/depois). O historico nunca
    //    pode ser editado nem apagado.
    // Conclusao gera exames/{id}/versoes/{n}: copia fechada e imutavel do
    // relatorio. So o DPP ou perfil regional da propria SR (SR, SR_PSICOLOGIA,
    // SR_SOCIAL) conclui; a unidade preenche e salva. Exame concluido so volta a ser editavel se SR/DPP reabrir, com
    // motivo. Exclusao e logica (status "excluido", com motivo), feita pelo DPP
    // ou por perfil de nivel regional da propria SR (SR, SR_PSICOLOGIA,
    // SR_SOCIAL); o documento nunca e apagado de fato.
    function podeVer(d) {
      return ehDPP()
        || minhaSR(d.sr)
        || minhaSRComoCobertura(d.sr)
        || minhaUnidade(d.unidade)
        || (ehNivelUnidade() && d.unidade == perfilAtual().unidade)
        // HCTP (psiquiatra): so os exames com pedido ao HCTP ativo ou realizado (hctpPedido, ligado pelo Centro)
        || (ativo() && perfilAtual().perfil == 'HCTP' && d.get('hctpPedido', false) == true);
    }
    function ehSROuDPPDo(d) { return ehDPP() || minhaSR(d.sr); }
    // concluir e excluir: DPP ou qualquer perfil regional da propria SR
    function ehRegionalOuDPPDo(d) { return ehSROuDPPDo(d) || minhaSRComoCobertura(d.sr); }
    function exameDoc(examId) { return /databases/$(database)/documents/exames/$(examId); }
    function historicoDoc(examId, rev) { return /databases/$(database)/documents/exames/$(examId)/historico/$(string(rev)); }
    function versaoDoc(examId, n) { return /databases/$(database)/documents/exames/$(examId)/versoes/$(string(n)); }
    function metaOk() {
      return request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
    }
    function motivoOk(h) { return h.motivo is string && h.motivo.size() > 0; }
    // Peticionamento no SEEU (exame concluido): marca ou desmarca so o campo peticionado, sempre
    // em nome de quem esta logado, ligado a versao fechada atual. Quem pode fica a cargo de
    // edicaoPorSecaoOk (Psicologia/Servico Social da unidade e HCTP nao gravam esse campo).
    function peticaoOk(n, a, h) {
      let p = n.get('peticionado', {});
      return h.acao in ['peticionou', 'desfezPeticao']
        && n.diff(a).affectedKeys().hasOnly(['peticionado','rev','updatedBy','updatedByNome','updatedAt'])
        && p.get('ok', null) is bool
        && (p.ok == false || (p.get('data', '') is string && p.get('data', '').size() == 10))
        && p.get('versao', null) == a.get('versaoFinal', null)
        && p.get('por', null) == request.auth.uid
        && p.get('em', null) == request.time;
    }
    // Aviso a CPEN da unidade (exame concluido): quem conclui (SR/perfis regionais da propria SR ou DPP)
    // avisa, ligado a versao fechada atual (o aviso sai do sininho da CPEN quando ela abre o exame; nada e gravado).
    function avisoCpenOk(n, a, h) {
      let v = n.get('avisoCpen', {});
      return n.diff(a).affectedKeys().hasOnly(['avisoCpen','rev','updatedBy','updatedByNome','updatedAt'])
        && h.acao == 'avisouCpen'
        && ehRegionalOuDPPDo(a)
        && v.get('versao', null) == a.get('versaoFinal', null)
        && v.get('por', null) == request.auth.uid
        && v.get('em', null) == request.time;
    }
    function transicaoOk(examId) {
      let de = resource.data.get('status', 'andamento');
      let para = request.resource.data.get('status', 'andamento');
      let n = request.resource.data;
      let h = getAfter(historicoDoc(examId, n.rev)).data;
      return de == 'excluido' ? false
        : de == 'concluido' ? (
            para == 'concluido' ? (peticaoOk(n, resource.data, h) || avisoCpenOk(n, resource.data, h))
            : para == 'andamento'
            && ehSROuDPPDo(resource.data)
            && h.acao == 'reabriu' && motivoOk(h)
            && n.diff(resource.data).affectedKeys().hasOnly(['status','rev','updatedBy','updatedByNome','updatedAt']))
        : para == 'andamento' ? true
        : para == 'concluido' ? (
            ehRegionalOuDPPDo(resource.data)
            && n.finalizedBy == request.auth.uid
            && n.finalizedAt == request.time
            && n.versaoFinal == resource.data.get('versaoFinal', 0) + 1
            && existsAfter(versaoDoc(examId, n.versaoFinal)))
        : para == 'excluido' ? (
            ehRegionalOuDPPDo(resource.data)
            && h.acao == 'excluiu' && motivoOk(h)
            && n.excluidoBy == request.auth.uid
            && n.excluidoAt == request.time)
        : false;
    }
    // Secoes tecnicas (autoria e responsabilidade individual): na unidade, a conta de
    // Psicologia so grava a secao de Psicologia do relatorio e a de Servico Social so a
    // de Servico Social (texto, "Secao concluida" e quem marcou) — nao cadastram exame
    // nem mexem no resto. As demais contas da unidade (USUARIO, DIR, CPEN) gravam o
    // resto do exame, menos essas duas secoes. Perfis regionais da propria SR (SR,
    // SR_PSICOLOGIA, SR_SOCIAL) e o DPP editam tudo. A conta HCTP (psiquiatra) so grava a secao
    // de Psiquiatria, nos exames com pedido ao HCTP.
    function secaoDoPerfil(p) { return p == 'PSICOLOGIA' ? 'psi' : p == 'SOCIAL' ? 'soc' : 'psq'; }
    function mudouEm(n, a, campo) { return n.get(campo, {}).diff(a.get(campo, {})).affectedKeys(); }
    // Versoes das checagens de perfil que recebem o perfil ja lido (eu = perfilAtual()), para
    // a gravacao de exame ler o cadastro uma vez so — o Firestore limita cada verificacao a
    // 1000 operacoes. Mesmo alcance de podeVer / ehRegionalOuDPPDo acima.
    function regionalOuDPP(d, eu) {
      return eu.status == 'ATIVO' && (eu.perfil == 'DPP'
        || (eu.perfil in ['SR','SR_PSICOLOGIA','SR_SOCIAL'] && eu.get('sr', null) != null && eu.get('sr', null) == d.get('sr', null)));
    }
    function podeVerComo(d, eu) {
      return regionalOuDPP(d, eu)
        || (eu.status == 'ATIVO' && eu.perfil in ['USUARIO','PSICOLOGIA','SOCIAL','DIR','CPEN']
            && eu.get('unidade', null) != null && eu.get('unidade', null) == d.get('unidade', null))
        || (eu.status == 'ATIVO' && eu.perfil == 'HCTP' && d.get('hctpPedido', false) == true);
    }
    // Entrevistas (etapas ent1/ent2/entConv e as opcionais ent3 e entFam): as contas de Psicologia e Servico Social da unidade
    // agendam, alteram e desmarcam so as da propria area ou da Equipe (area vazia), sem trocar a area.
    // O HCTP nao mexe em entrevistas.
    function areaDoPerfil(p) { return p == 'PSICOLOGIA' ? 'psi' : p == 'SOCIAL' ? 'social' : 'nenhuma'; }
    function entrevistaOk(n, a, k, area) {
      let antes = a.get('etapas', {}).get(k, {}).get('area', '');
      return n.get('etapas', {}).get(k, {}).get('area', '') == antes && antes in [area, ''];
    }
    function entrevistasOk(n, a, area) {
      let m = mudouEm(n, a, 'etapas');
      return m.size() == 0 || (area != 'nenhuma' && m.hasOnly(['ent1','ent2','entConv','ent3','entFam'])
        && (!('ent1' in m) || entrevistaOk(n, a, 'ent1', area))
        && (!('ent2' in m) || entrevistaOk(n, a, 'ent2', area))
        && (!('entConv' in m) || entrevistaOk(n, a, 'entConv', area))
        && (!('ent3' in m) || entrevistaOk(n, a, 'ent3', area))
        && (!('entFam' in m) || entrevistaOk(n, a, 'entFam', area)));
    }
    function edicaoPorSecaoOk(n, a, eu) {
      let p = eu.perfil;
      return regionalOuDPP(a, eu) ? true
        : p in ['PSICOLOGIA','SOCIAL','HCTP'] ? (
            n.diff(a).affectedKeys().hasOnly(['rel','relOk','relOkPor','rev','updatedBy','updatedByNome','updatedAt','numCrim','etapas'])
            && entrevistasOk(n, a, areaDoPerfil(p))
            && mudouEm(n, a, 'rel').hasOnly([secaoDoPerfil(p)])
            && mudouEm(n, a, 'relOk').hasOnly([secaoDoPerfil(p)])
            && mudouEm(n, a, 'relOkPor').hasOnly([secaoDoPerfil(p)]))
        : !mudouEm(n, a, 'rel').hasAny(['psi','soc'])
          && !mudouEm(n, a, 'relOk').hasAny(['psi','soc'])
          && !mudouEm(n, a, 'relOkPor').hasAny(['psi','soc']);
    }
    // Registro eletronico de autoria e conclusao (vale para todos os perfis):
    //  - quem grava "Secao concluida" (relOkPor.<secao>) so registra a si mesmo: uid e nome da
    //    propria conta, matricula da propria conta (quando enviada) e hora do servidor;
    //  - o texto de uma secao concluida so muda junto com um novo registro de conclusao
    //    (nova versao da secao); sem isso, a marca de concluida tem de cair na mesma gravacao;
    //  - o numero do exame (numCrim) e atribuido uma vez e nao muda mais.
    // (as comparacoes sao calculadas uma vez so em autoriaOk e passadas adiante: o Firestore
    // limita cada verificacao a 1000 operacoes)
    function porOk(k, mudou, por, nome, mat) {
      return !(k in mudou) || por.get(k, null) == null || (
        por[k].uid == request.auth.uid
        && por[k].em == request.time
        && por[k].get('nome', '') == nome
        && por[k].get('mat', mat) == mat);
    }
    // secoes concluidas (relOk == true): a diferenca contra um mapa todo "false" da so as marcadas
    function concluidas(n) {
      return n.get('relOk', {}).diff({'coord': false, 'direcao': false, 'chefiaSeg': false, 'execPenal': false,
        'ativLab': false, 'ensino': false, 'psq': false, 'psi': false, 'soc': false, 'sin': false}).changedKeys();
    }
    // secoes cujo texto mudou: o campo tem o nome da secao, menos Metodologia (met -> coord)
    // e Sintese (sin, diverg, limit -> sin)
    function secoesComTextoMudado(relMudou) {
      return relMudou
        .union(relMudou.hasAny(['met']) ? ['coord'].toSet() : [].toSet())
        .union(relMudou.hasAny(['diverg', 'limit']) ? ['sin'].toSet() : [].toSet());
    }
    function registrosOk(mudou, por, nome, mat) {
      return porOk('coord', mudou, por, nome, mat) && porOk('direcao', mudou, por, nome, mat)
        && porOk('chefiaSeg', mudou, por, nome, mat) && porOk('execPenal', mudou, por, nome, mat)
        && porOk('ativLab', mudou, por, nome, mat) && porOk('ensino', mudou, por, nome, mat)
        && porOk('psq', mudou, por, nome, mat) && porOk('psi', mudou, por, nome, mat)
        && porOk('soc', mudou, por, nome, mat) && porOk('sin', mudou, por, nome, mat);
    }
    function autoriaOk(n, a, eu) {
      let porMudou = mudouEm(n, a, 'relOkPor');
      let relMudou = mudouEm(n, a, 'rel');
      return (porMudou.size() == 0
          || registrosOk(porMudou, n.get('relOkPor', {}), eu.get('nome', ''), eu.get('matricula', '')))
        && (relMudou.size() == 0 || !secoesComTextoMudado(relMudou).hasAny(concluidas(n).difference(porMudou)))
        && (a.get('numCrim', null) == null || n.get('numCrim', null) == a.get('numCrim', null));
    }
    function criacaoPorSecaoOk(n, eu) {
      let p = eu.perfil;
      return regionalOuDPP(n, eu) ? true
        : p in ['PSICOLOGIA','SOCIAL','HCTP'] ? false
        : n.get('rel', {}).get('psi', '') == '' && n.get('rel', {}).get('soc', '') == ''
          && n.get('relOk', {}).get('psi', false) == false && n.get('relOk', {}).get('soc', false) == false;
    }
    // Contadores (numero do oficio de comunicacao ao Juizo, por Centro e ano):
    // so sobe de 1 em 1, nunca volta nem e apagado.
    match /contadores/{id} {
      allow read: if ativo();
      allow create: if ativo() && (id.matches('oficio-.+') || id.matches('crim-.+'))
        && request.resource.data.keys().hasOnly(['n','por','em'])
        && request.resource.data.n == 1
        && request.resource.data.por == request.auth.uid
        && request.resource.data.em == request.time;
      allow update: if ativo()
        && request.resource.data.keys().hasOnly(['n','por','em'])
        && request.resource.data.n == resource.data.n + 1
        && request.resource.data.por == request.auth.uid
        && request.resource.data.em == request.time;
      allow delete: if false;
    }
    function criacaoOk(examId, eu) {
      let n = request.resource.data;
      return podeVerComo(n, eu)
        && metaOk()
        && n.rev == 1
        && n.get('status', 'andamento') == 'andamento'
        && n.createdBy == request.auth.uid
        && n.createdAt == request.time
        && criacaoPorSecaoOk(n, eu)
        && autoriaOk(n, {}, eu)
        && existsAfter(historicoDoc(examId, 1));
    }
    function atualizacaoOk(examId, eu) {
      let n = request.resource.data;
      let a = resource.data;
      return podeVerComo(a, eu)
        && podeVerComo(n, eu)
        && metaOk()
        && n.rev == a.get('rev', 0) + 1
        && n.get('createdBy', null) == a.get('createdBy', null)
        && n.get('createdAt', null) == a.get('createdAt', null)
        && existsAfter(historicoDoc(examId, n.rev))
        && transicaoOk(examId)
        && edicaoPorSecaoOk(n, a, eu)
        && autoriaOk(n, a, eu);
    }
    // Agendamento da avaliacao psiquiatrica no HCTP (colecao hctp). O Centro (quem ve o exame)
    // pede, para crime sexual ou outra demanda (ex.: transtorno mental); a conta HCTP (perfil
    // estadual, aprovado pelo DPP) responde com data/hora/local ou recusa; depois de agendado, os
    // dois lados remarcam e cancelam. O HCTP NAO le exames (podeVer/podeVerComo nao o incluem):
    // so a ficha da solicitacao, com nome/IPEN/unidade copiados do exame e conferidos aqui.
    // "eventos" (quem/quando/o que) so cresce: cada mudanca acrescenta um item e preserva os
    // anteriores. Pedido recusado, cancelado ou realizado nao muda mais (faz-se outro pedido).
    function ehHctpConta(eu) { return eu.status == 'ATIVO' && eu.perfil == 'HCTP'; }
    function hctpCriacaoOk(eu) {
      let n = request.resource.data;
      let ex = get(exameDoc(n.exameId)).data;
      return !ehHctpConta(eu) && podeVerComo(ex, eu)
        && n.keys().hasOnly(['exameId','nome','ipen','unidade','sr','coc','cocNome','prazo','motivo','obs','status','data','hora',
             'dur','local','resposta','motivoCancelamento','novidadeParaHctp','novidadeParaCentro','solicitadoPor',
             'solicitadoPorNome','solicitadoEm','atualizadoPor','atualizadoPorNome','atualizadoEm','atualizadoLado','eventos'])
        && n.nome == ex.nome && n.ipen == ex.get('mat', '') && n.unidade == ex.get('unidade', null) && n.sr == ex.get('sr', null)
        && n.status == 'solicitado' && n.motivo in ['crimeSexual','transtorno','outra']
        && n.solicitadoPor == request.auth.uid && n.solicitadoEm == request.time
        && n.atualizadoPor == request.auth.uid && n.atualizadoEm == request.time && n.atualizadoLado == 'Centro'
        && n.novidadeParaHctp == true && n.novidadeParaCentro == false
        && n.eventos is list && n.eventos.size() == 1;
    }
    function hctpAtualizacaoOk(eu) {
      let n = request.resource.data;
      let a = resource.data;
      let mudou = n.diff(a).affectedKeys();
      let doHctp = ehHctpConta(eu);
      let doCentro = !doHctp && podeVerComo(a, eu);
      return mudou.hasOnly(['novidadeParaHctp','novidadeParaCentro'])
        // "Ciente": cada lado so apaga o proprio aviso
        ? ((doHctp && mudou.hasOnly(['novidadeParaHctp']) && n.novidadeParaHctp == false)
           || (doCentro && mudou.hasOnly(['novidadeParaCentro']) && n.novidadeParaCentro == false))
        : (doHctp || doCentro)
          && mudou.hasOnly(['status','data','hora','dur','local','resposta','motivoCancelamento','novidadeParaHctp',
               'novidadeParaCentro','eventos','atualizadoPor','atualizadoPorNome','atualizadoEm','atualizadoLado'])
          && n.atualizadoPor == request.auth.uid && n.atualizadoEm == request.time
          && n.atualizadoLado == (doHctp ? 'HCTP' : 'Centro')
          && n.eventos.size() == a.eventos.size() + 1 && n.eventos[0:a.eventos.size()] == a.eventos
          && a.status in ['solicitado','agendado']
          && (doHctp
              ? n.status in ['agendado','recusado','cancelado','realizado']
              // o Centro cancela, ou remarca o que ja esta agendado (sem mexer em local/duracao/resposta do HCTP)
              : (n.status == 'cancelado' || (n.status == 'agendado' && a.status == 'agendado'))
                && !mudou.hasAny(['resposta','local','dur']));
    }
    match /hctp/{id} {
      allow read: if (ativo() && perfilAtual().perfil == 'HCTP') || podeVer(resource.data);
      allow create: if autenticado() && hctpCriacaoOk(perfilAtual());
      allow update: if autenticado() && hctpAtualizacaoOk(perfilAtual());
      allow delete: if false;
    }
    // Anexos do exame (decisao judicial, BPI...): arquivo em pedacos dentro do banco.
    // Leem quem ve o exame, menos o HCTP; anexam/removem quem edita o exame (menos Psicologia/Servico
    // Social da unidade e HCTP), so com o exame em andamento. Nada e apagado: remover marca "removido".
    function anexoLeitura(examId) {
      return autenticado() && perfilAtual().perfil != 'HCTP' && podeVer(get(exameDoc(examId)).data);
    }
    function anexoEscrita(examId) {
      let eu = perfilAtual();
      let ex = get(exameDoc(examId)).data;
      return !(eu.perfil in ['PSICOLOGIA','SOCIAL','HCTP']) && podeVerComo(ex, eu) && ex.get('status', 'andamento') == 'andamento';
    }
    match /exames/{examId} {
      allow read: if podeVer(resource.data)
        || (ativo() && perfilAtual().perfil == 'HCTP' && resource.data.hctpPedido == true);
      allow create: if autenticado() && criacaoOk(examId, perfilAtual());
      allow update: if autenticado() && atualizacaoOk(examId, perfilAtual());
      allow delete: if false;

      match /historico/{rev} {
        allow read: if podeVer(get(exameDoc(examId)).data);
        allow create: if request.resource.data.autor == request.auth.uid
          && request.resource.data.em == request.time
          && request.resource.data.rev == int(rev)
          && getAfter(exameDoc(examId)).data.rev == int(rev)
          && getAfter(exameDoc(examId)).data.updatedAt == request.time
          && podeVer(getAfter(exameDoc(examId)).data);
        allow update, delete: if false;
      }
      match /anexos/{anexoId} {
        allow read: if anexoLeitura(examId);
        allow create: if autenticado() && anexoEscrita(examId)
          && request.resource.data.keys().hasOnly(['nome','tipo','tamanho','partes','enviadoPor','enviadoPorNome','enviadoEm','removido'])
          && request.resource.data.enviadoPor == request.auth.uid && request.resource.data.enviadoEm == request.time
          && request.resource.data.removido == false
          && request.resource.data.nome is string && request.resource.data.nome.size() <= 200
          && request.resource.data.tamanho is int && request.resource.data.tamanho <= 10485760
          && request.resource.data.partes is int && request.resource.data.partes <= 20;
        allow update: if autenticado() && anexoEscrita(examId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['removido','removidoPor','removidoPorNome','removidoEm'])
          && request.resource.data.removido == true && request.resource.data.removidoPor == request.auth.uid
          && request.resource.data.removidoEm == request.time;
        allow delete: if false;
        match /partes/{i} {
          allow read: if anexoLeitura(examId);
          allow create: if autenticado() && anexoEscrita(examId)
            && request.resource.data.keys().hasOnly(['i','dados'])
            && request.resource.data.dados is string && request.resource.data.dados.size() <= 1000000;
          allow update, delete: if false;
        }
      }
      match /versoes/{n} {
        allow read: if podeVer(get(exameDoc(examId)).data);
        allow create: if request.resource.data.finalizadoPor == request.auth.uid
          && request.resource.data.em == request.time
          && request.resource.data.n == int(n)
          && getAfter(exameDoc(examId)).data.status == 'concluido'
          && getAfter(exameDoc(examId)).data.versaoFinal == int(n)
          && getAfter(exameDoc(examId)).data.finalizedAt == request.time
          && podeVer(getAfter(exameDoc(examId)).data);
        allow update, delete: if false;
      }
    }
  }
}
